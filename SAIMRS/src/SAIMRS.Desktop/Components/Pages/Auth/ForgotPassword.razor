@page "/forgot-password"
@layout AuthLayout
@inherits AppComponentBase

<a href="login" class="auth-back"><i class="fas fa-arrow-left"></i> Back to login</a>

<div class="auth-heading">
    <h2>Reset your password</h2>
    <p>@StepHint</p>
</div>

<div class="stepper">
    <span class="@(_step >= 1 ? "on" : "")">1</span><i></i>
    <span class="@(_step >= 2 ? "on" : "")">2</span><i></i>
    <span class="@(_step >= 3 ? "on" : "")">3</span>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="form-error"><i class="fas fa-circle-exclamation"></i><span>@_error</span></div>
}

<form @onsubmit="NextAsync" class="auth-form">
    @if (_step == 1)
    {
        <div class="line-field">
            <label>Username</label>
            <input type="text" @bind="_request.Username" autofocus autocomplete="off" />
        </div>
    }
    else if (_step == 2)
    {
        <div class="question-box">
            <i class="fas fa-circle-question"></i>
            <span>@_question</span>
        </div>
        <div class="line-field">
            <label>Your Answer</label>
            <input type="text" @bind="_request.SecurityAnswer" autocomplete="off" />
        </div>
    }
    else
    {
        <div class="line-field">
            <label>New Password</label>
            <div class="with-toggle">
                <input type="@(_showPassword ? "text" : "password")" @bind="_request.NewPassword" />
                <button type="button" class="toggle-eye" @onclick="() => _showPassword = !_showPassword">
                    <i class="fas @(_showPassword ? "fa-eye-slash" : "fa-eye")"></i>
                </button>
            </div>
            <small>At least @PasswordPolicy.MinLength characters.</small>
        </div>
        <div class="line-field">
            <label>Confirm New Password</label>
            <input type="@(_showPassword ? "text" : "password")" @bind="_request.ConfirmPassword" />
        </div>
    }

    <button type="submit" class="btn primary block" disabled="@Busy">
        @if (Busy) { <i class="fas fa-spinner fa-spin"></i> }
        @(_step == 3 ? "RESET PASSWORD" : "CONTINUE")
    </button>
</form>

@code {
    private readonly ResetPasswordRequest _request = new();
    private int _step = 1;
    private string? _question;
    private bool _showPassword;
    private string? _error;

    private string StepHint => _step switch
    {
        1 => "Enter your username to see your security question.",
        2 => "Answer your security question.",
        _ => "Choose a new password."
    };

    private Task NextAsync() => RunBusyAsync(async () =>
    {
        _error = null;
        switch (_step)
        {
            case 1:
            {
                var result = await Use<IAuthService>().Run(s => s.GetSecurityQuestionAsync(_request.Username));
                if (result.IsFailure || result.Value is null) { _error = result.Error; return; }
                _question = result.Value.Text;
                _step = 2;
                break;
            }
            case 2:
            {
                var result = await Use<IAuthService>().Run(s => s.VerifySecurityAnswerAsync(_request.Username, _request.SecurityAnswer));
                if (result.IsFailure) { _error = result.Error; return; }
                _step = 3;
                break;
            }
            default:
            {
                var result = await Use<IAuthService>().Run(s => s.ResetPasswordAsync(_request));
                if (result.IsFailure) { _error = result.Error; return; }
                Toast.Success("Your password was changed. Please log in with your new password.");
                Nav.NavigateTo("login", replace: true);
                break;
            }
        }
    });
}
