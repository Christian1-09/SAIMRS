<Modal Title="@(Request.Id is null ? "Add Beneficiary" : "Edit Beneficiary")" Icon="fa-user-group" Error="@Error" OnClose="OnCancel">
    <ChildContent>
        <form id="ben-form" @onsubmit="OnSave">
            <div class="form-row">
                <div class="form-group">
                    <label>Full Name *</label>
                    <input type="text" @bind="Request.FullName" placeholder="e.g. Juan Dela Cruz" maxlength="120" />
                </div>
                <div class="form-group">
                    <label>Barangay *</label>
                    <input type="text" list="barangay-list" @bind="Request.Barangay" placeholder="e.g. Upper Irasan" maxlength="80" />
                    <datalist id="barangay-list">
                        @foreach (var b in Barangays)
                        {
                            <option value="@b"></option>
                        }
                    </datalist>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Contact No.</label>
                    <input type="text" @bind="Request.ContactNumber" placeholder="09XX-XXX-XXXX" maxlength="30" />
                </div>
                <div class="form-group">
                    <label>Farm Size (hectares)</label>
                    <input type="number" min="0" step="0.1" @bind="Request.FarmSizeHectares" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Crop Type</label>
                    <select @bind="Request.CropType">
                        @foreach (var crop in Enum.GetValues<CropType>())
                        {
                            <option value="@crop">@crop</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select @bind="Request.Status">
                        <option value="@BeneficiaryStatus.Active">Active</option>
                        <option value="@BeneficiaryStatus.Inactive">Inactive</option>
                    </select>
                </div>
            </div>
            @if (Request.Id is null)
            {
                <div class="hint-box"><i class="fas fa-circle-info"></i> The Beneficiary ID (e.g. BEN-0006) is assigned automatically.</div>
            }
        </form>
    </ChildContent>
    <Footer>
        <button type="button" class="btn ghost" @onclick="OnCancel">Cancel</button>
        <button type="submit" form="ben-form" class="btn primary" disabled="@Busy"><i class="fas fa-floppy-disk"></i> Save Beneficiary</button>
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public SaveBeneficiaryRequest Request { get; set; } = default!;
    [Parameter] public List<string> Barangays { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
