<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!-- Presentation layer + composition root: a WPF window hosting Blazor (BlazorWebView). -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<UseWPF>true</UseWPF>
		<RootNamespace>SAIMRS.Desktop</RootNamespace>
		<AssemblyName>SAIMRS</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SAIMRS.Application\SAIMRS.Application.csproj" />
		<ProjectReference Include="..\SAIMRS.Infrastructure\SAIMRS.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.*" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
	</ItemGroup>

	<ItemGroup>
		<!-- WPF removes System.IO from implicit usings; Razor pages and services need it. -->
		<Using Include="System.IO" />
	</ItemGroup>

</Project>